generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("MEMBER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Nota {
  id        String   @id @default(cuid())
  texto     String
  createdAt DateTime @default(now())
}
